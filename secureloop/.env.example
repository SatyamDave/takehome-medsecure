# Devin AI API Key (required)
# Get your API key from https://app.devin.ai/settings
DEVIN_API_KEY=your_devin_api_key_here

# GitHub Token (optional - Devin uses its own GitHub App)
# GITHUB_TOKEN=your_github_token_here

# Slack Webhook URL (optional)
# Get from: Slack workspace → Apps → Incoming Webhooks → Add New Webhook
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX
